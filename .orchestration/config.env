# pi-orchestration — tunables. Sourced by bin/pi-workhorse.sh.
# Everything here is overridable by an environment variable of the same name,
# so a host can change behaviour without editing the bundle.

# Provider for an explicitly passed model. Leave empty unless the model you
# name lives outside pi's default provider -- e.g. ORCH_PROVIDER=ollama-cloud
# to use kimi-k2.7-code:cloud or any other catalogue entry. Escalation sets its
# own provider from ORCH_ESCALATION_PROVIDER and ignores this.
: "${ORCH_PROVIDER:=}"

# Model for normal implementation work. EMPTY means "whatever pi is configured
# to use" (settings.json / PI_MODEL / PI_PROVIDER). Leave it empty unless you
# have a reason: a model pinned here silently contradicts pi's own config.
: "${ORCH_MODEL:=}"

# Model used when work is escalated: a stalled implement, ORCH_MAX_REPAIR_ROUNDS
# failed gate rounds, or a manual --escalate.
#
# PREFER A PROVIDER THAT CACHES PROMPTS. Measured on a 20k-line repo:
# glm-5.2:cloud (ollama-cloud) completed a spec in 36 calls and 1,506,360
# tokens with cacheRead of ZERO -- ollama-cloud does no prompt caching, so every
# call re-sent the whole conversation. deepseek on the same work showed
# cacheRead of 35k-147k. deepseek-v4-pro is the stronger model on that caching
# provider, so it is the default: same escalation, a fraction of the tokens.
#
# glm-5.2:cloud remains a good choice when deepseek is unavailable or has
# already failed the task -- set it here and change the provider to
# ollama-cloud.
: "${ORCH_ESCALATION_MODEL:=deepseek-v4-pro}"
: "${ORCH_ESCALATION_PROVIDER:=deepseek}"

# Repair rounds at the normal model before escalating. Beyond ~2, a model that
# cannot see the problem will not see it on the third try either.
: "${ORCH_MAX_REPAIR_ROUNDS:=2}"

# Bound on the agent's tool-call loop per turn.
: "${ORCH_MAX_TOOL_ITERATIONS:=60}"

# Seconds for a single provider API call (pi's --request-timeout). This does
# NOT bound the agent's tool loop.
: "${ORCH_REQUEST_TIMEOUT:=600}"

# Wall-clock seconds for an entire phase, enforced with `timeout`. This is the
# one that actually stops a runaway: a phase once ran 40 minutes because
# ORCH_REQUEST_TIMEOUT was documented but never passed to pi, and even wired it
# would only have bounded one API call. 0 disables.
: "${ORCH_PHASE_TIMEOUT:=1800}"

# Where the bundle was installed. Set by install.sh; used to find DIRECTIVES.md.
: "${ORCH_HOME:=$HOME/.pi-orchestration}"
